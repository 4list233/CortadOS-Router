__pycache__/
*.pyc
.venv*/
# CortadOS Router S1: training data, runs, adapters and the promotion record are local only (never published)
s1/data/
s1/runs/
s1/sources/
s1/laya/
s1/current.json
*.safetensors
# the real S1 endpoints map holds this machine's tailnet addresses: local only (ship the .example instead)
tables/s1-endpoints.json
# the real accounts map holds machine-local CLI config-dir paths: local only (ship the .example)
tables/accounts.json
# runtime state belongs in ~/.cortados, never in the repository
*.db
# third-party benchmark downloads: re-fetched by tables/benchmarks/fetch_benchmarks.py, never redistributed
tables/benchmarks/raw/
# Claude Code worktrees are per-session scratch checkouts
.claude/worktrees/
