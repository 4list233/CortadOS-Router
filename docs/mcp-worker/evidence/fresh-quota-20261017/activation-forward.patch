+CONFIG_PATH = "/Users/velox/.config/cortados-workers/config.json"
+
+
+def _owners():
+    site = Path(RELEASE_SITE_PACKAGES).resolve()
+    if not site.is_dir():
+        raise RuntimeError("quota_unknown: pinned quota release unavailable")
+    if str(site) not in sys.path:
+        sys.path.insert(0, str(site))
+    quota = importlib.import_module("cortados_router.quota_admission")
+    config = importlib.import_module("integrations.mcp.config")
+    for module in (quota, config):
+        if not Path(module.__file__).resolve().is_relative_to(site):
+            raise RuntimeError("quota_unknown: quota owner outside pinned release")
+    return quota, config.load_config(CONFIG_PATH)
+
+
+def _unknown():
+    return {"status": "unknown", "kind": "subscription", "lane": None,
+            "pool": None, "observed_at": None, "age_s": None,
+            "source": "pinned-release", "reason": "quota owner or configuration unavailable"}
+
+
+def check(provider, model, *, auth_scope):
+    try:
+        owner, config = _owners()
+        return owner.check(provider, model, auth_scope=auth_scope, config=config)
+    except Exception:
+        return _unknown()
+
+
+def source_preflight(provider, model):
+    try:
+        owner, config = _owners()
+        return owner.source_preflight(provider, model, config=config)
+    except Exception:
+        return {"quota_stage": "source_preflight", "auth_scope": {
+            "kind": "unproven", "lane": None, "scope_id": None}, "quota": _unknown()}
+
+
+def auth_scope(provider, *, environment, executable, argv=()):
+    try:
+        owner, config = _owners()
+        return owner.auth_scope(provider, environment=environment, executable=executable,
+                                argv=argv, config=config)
+    except Exception:
+        return {"kind": "unproven", "lane": None, "scope_id": None}
+
+
+def resources(candidates):
+    owner, config = _owners()
+    return owner.current_resources(candidates, config=config)
+
+
+def codex_status():
+    """Normal status uses the installed native source, never the diagnostic TUI."""
+    _owners()
+    owner = importlib.import_module("cortados_router.scarcity")
+    if not Path(owner.__file__).resolve().is_relative_to(Path(RELEASE_SITE_PACKAGES).resolve()):
+        raise RuntimeError("quota_unknown: status owner outside pinned release")
+    return owner._codex_native()
