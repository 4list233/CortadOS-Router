+    elif kind == 'route':
+        route = value['route']
+        result = {'ok': True, 'route': {key: route[key] for key in ('route_id', 'selection_mode', 'chosen', 'context', 'quota')}}
+    elif kind == 'receipt':
+        result = {'ok': True, 'task_id': value['task_id'], 'artifact': artifact_projection(value['artifact'])}
+    elif kind == 'task':
