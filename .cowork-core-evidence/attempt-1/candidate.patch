+    elif kind == 'ticket':
+        ticket = TicketRow(**value['ticket'])
+        result = {'ok': True, 'ticket': {key: getattr(ticket, key) for key in ('ticket_id', 'artifact_id', 'expires_at_ms', 'bytes', 'sha256')}}
+        result['ticket'].update(method='PUT' if ticket.direction == 'put' else 'GET',
