+        row = tickets.artifact(tx, lease.owner_id, lease.task_id, lease.artifact_id)
+        if row.state != 'uploading':
+            store.save(tx, 'remote_artifacts', store.changed(row, state='uploading'))
+    return offset + len(body)
+
+
