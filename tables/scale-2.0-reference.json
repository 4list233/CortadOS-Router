  "table_id": "RES-TABLE-001",
  "table_version": 1,
  "status": "proposed",
  "features": [
    {
      "name": "steps",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "one action or lookup",
        "1": "a short sequence with one dependency",
        "2": "a multi-step chain with several dependencies",
        "3": "a long dependent chain"
      }
    },
    {
      "name": "ambiguity",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "directive fully determines the work",
        "1": "minor interpretation with an evident objective",
        "2": "substantial interpretation among plausible objectives",
        "3": "intent must be substantially interpreted"
      }
    },
    {
      "name": "blast_radius",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "words only, nothing changes",
        "1": "a bounded reversible workspace change",
        "2": "a broad or difficult-to-reverse system change",
        "3": "law, money, production, or irreversible effects nearby"
      }
    },
    {
      "name": "context_size",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "fits well inside the local 40,960-token window",
        "1": "fits the local window with moderate headroom",
        "2": "approaches or crosses the local window and benefits from decomposition",
        "3": "exceeds a single frontier context; must be decomposed"
      }
    },
    {
      "name": "novelty",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "matches patterns in memory/corpus",
        "1": "a known pattern with a small variation",
        "2": "a materially new pattern needing investigation",
        "3": "nothing like it recorded"
      }
    },
    {
      "name": "parallelizability",
      "min": 0,
      "max": 3,
      "anchors": {
        "0": "strictly serial",
        "1": "mostly serial with one independent branch",
        "2": "several independent subtasks can proceed concurrently",
        "3": "mostly independent subtasks"
      }
    }
  ],
  "difficulty": {
    "formula": "steps + ambiguity + blast_radius + novelty",
    "terms": [
      "steps",
      "ambiguity",
      "blast_radius",
      "novelty"
    ],
    "modifiers_not_difficulty": [
