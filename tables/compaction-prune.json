{
  "version": 1,
  "status": "provisional rule data for phase 1; shared numeric thresholds (keep-last results, pruning start, min freed, result cap, chars per token) are read from tables/compaction.json via compaction/policy.py, never copied here",
  "small_result_chars": {
    "value": 600,
    "why": "a result under N chars costs about as much as the note that would replace it, so dropping it saves nothing"
  },
  "dropped_head_chars": {
    "value": 300,
    "why": "a dropped result keeps a head of H chars so the model still sees what kind of output it was and can decide to re-run the read"
  },
  "rerunnable_tools": {
    "value": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebSearch",
      "NotebookRead"
    ],
    "why": "reads that can be re-run for the same content, so their results are cheap to drop"
  },
  "side_effect_tools": {
    "value": [
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "apply_patch",
      "TodoWrite"
    ],
    "why": "calls that changed state: the fact they happened must stay or the model may redo or contradict them"
  },
  "mcp_side_effect_words": {
    "value": [
      "send",
      "post",
      "create",
      "delete",
      "update",
      "write",
      "publish",
      "reply",
      "forward",
      "trash",
      "deploy",
      "pay",
      "set",
      "add",
      "remove",
      "upload",
      "apply",
      "merge",
      "cancel",
      "start"
    ],
    "why": "an MCP tool whose name holds one of these acts outside the session; its call must stay"
  },
  "assumed_window_tokens": {
    "value": 200000,
    "why": "the provider does not learn the backend's context window per turn; 200k is the common Claude window and the smaller of the routed windows, so the pruning start threshold min(cap, pct x W) is estimated conservatively (earlier, not later)"
  },
  "readonly_bash": {
    "value": {
      "cat": {
        "flags": [
          "-n",
          "-b",
          "-A",
          "-v"
        ],
        "positionals": true
      },
      "ls": {
        "flags": [
          "-l",
          "-a",
          "-A",
          "-h",
          "-R",
          "-t",
          "-r",
          "-1",
          "-d",
          "-S",
          "-F"
        ],
        "positionals": true
      },
      "head": {
        "flags": [
          "-n",
          "-c"
        ],
        "numeric": true,
        "positionals": true
      },
      "tail": {
        "flags": [
          "-n",
          "-c"
        ],
        "numeric": true,
        "positionals": true
      },
      "wc": {
        "flags": [
          "-l",
          "-c",
          "-w",
          "-m"
        ],
        "positionals": true
      },
      "grep": {
        "flags": [
          "-n",
          "-i",
          "-r",
          "-R",
          "-l",
          "-L",
          "-c",
          "-w",
          "-x",
          "-E",
          "-F",
          "-v",
          "-e",
          "-A",
          "-B",
          "-C",
          "-h",
          "-H",
          "-o",
          "-s",
          "-q",
          "--include",
          "--exclude",
          "--exclude-dir",
          "--color"
        ],
        "positionals": true
      },
      "rg": {
        "flags": [
          "-n",
          "-i",
          "-l",
          "-c",
          "-w",
          "-F",
          "-S",
          "-e",
          "-g",
          "-t",
          "-A",
          "-B",
          "-C",
          "-u",
          "--hidden",
          "--files",
          "--glob",
          "--type",
          "--no-heading",
          "--color"
        ],
        "positionals": true
      },
      "find": {
        "flags": [
          "-name",
          "-iname",
          "-type",
          "-maxdepth",
          "-mindepth",
          "-path",
          "-ipath",
          "-print",
          "-newer",
          "-size",
          "-mtime",
          "-not",
          "-o",
          "-and",
          "-or"
        ],
        "positionals": true
      },
      "pwd": {
        "flags": [],
        "positionals": false
      },
      "which": {
        "flags": [
          "-a"
        ],
        "positionals": true
      },
      "echo": {
        "flags": [
          "-n",
          "-e"
        ],
        "positionals": true
      },
      "stat": {
        "flags": [],
        "positionals": true
      },
      "file": {
        "flags": [],
        "positionals": true
      },
      "tree": {
        "flags": [
          "-L",
          "-a",
          "-d",
          "-f",
          "-I"
        ],
        "positionals": true
      },
      "git status": {
        "flags": [
          "-s",
          "-b",
          "--short",
          "--branch",
          "--porcelain"
        ],
        "positionals": false
      },
      "git log": {
        "flags": [
          "--oneline",
          "--stat",
          "-p",
          "--name-only",
          "--name-status",
          "--graph",
          "--decorate",
          "--all",
          "-n",
          "--format",
          "--pretty",
          "--since",
          "--until",
          "--author",
          "--follow"
        ],
        "numeric": true,
        "positionals": true
      },
      "git diff": {
        "flags": [
          "--stat",
          "--name-only",
          "--name-status",
          "--cached",
          "--staged",
          "-w",
          "--color"
        ],
        "positionals": true
      },
      "git show": {
        "flags": [
          "--stat",
          "--name-only",
          "--name-status",
          "--oneline",
          "--format",
          "--pretty"
        ],
        "positionals": true
      },
      "git branch": {
        "flags": [
          "-a",
          "-r",
          "-v",
          "-vv",
          "--list",
          "--show-current",
          "--all",
          "--remotes"
        ],
        "positionals": false
      }
    },
    "why": "read-only commands as an ALLOWLIST of command + argument shapes, checked on the shlex-tokenized command: every flag must be listed (short-flag clusters like -rn are split; --opt=value is checked by --opt), positionals are allowed only where the command takes paths/patterns/refs (git branch/status take none, so `git branch x` creates and is a side effect). Anything else, any unknown flag (find -delete/-exec, git branch -D, sed -i, git diff --output), a parse failure, any ; & | < > ` $( or line break, or any shell expansion that could change the words the command receives ($ or ` outside single quotes, unquoted * ? [ { !; e.g. `find . $FIND_ARGS`) is a side effect: keeping a call by mistake costs tokens, dropping a side effect by mistake loses state."
  }
}
