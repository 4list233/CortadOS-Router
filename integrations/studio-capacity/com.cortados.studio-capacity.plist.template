<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cortados.studio-capacity</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string><string>-B</string><string>-m</string>
    <string>cortados_router.studio_capacity</string>
    <string>--model</string><string>studio-qwen3-8b:latest</string>
    <string>--status</string><string>__HOME__/Library/Application Support/CortadOS/studio-capacity.json</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/cortados-studio-capacity.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/cortados-studio-capacity.log</string>
</dict>
</plist>
